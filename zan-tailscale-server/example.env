# Copy to .env with scripts/init-env.sh (it generates WEBUI_SECRET_KEY). Never commit .env.

# Image tags. Pin to specific versions once things work; see README "Updating".
OLLAMA_TAG=latest
OPEN_WEBUI_TAG=main
TAILSCALE_TAG=stable

# Host-only port for Open WebUI (bound to 127.0.0.1).
WEBUI_LOCAL_PORT=3000

# Tailscale machine name -> https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=ai-desktop

# Fill in after Tailscale login (README step 5), e.g. https://ai-desktop.tailXXXXXX.ts.net
WEBUI_URL=
CORS_ALLOW_ORIGIN=http://localhost:3000

# Model memory tuning (RTX 4060 Ti 16 GB + qwen2.5-coder:14b).
#   32768 + q8_0 -> ~13 GB VRAM (default; OpenHands needs >= 22K context)
#   16384 + f16  -> ~13 GB VRAM (chat-only alternative, slightly higher quality KV cache)
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=30m

# --- OpenHands (repo-based coding agent) ---
OPENHANDS_TAG=1.8
OPENHANDS_AGENT_SERVER_TAG=1.26.0-python
OPENHANDS_LOCAL_PORT=3001
CADDY_TAG=2
# Your Tailscale login (shown by: docker exec tailscale tailscale status --json | grep LoginName).
# Only requests from this Tailscale user get through oh-gate to OpenHands.
TS_ALLOWED_LOGIN=
# For remote use set both to your ts.net address (sandbox ports go through Tailscale Serve), e.g.
#   OPENHANDS_WEB_URL=https://ai-desktop.tailXXXXXX.ts.net:8443
#   OPENHANDS_SANDBOX_URL_PATTERN=https://ai-desktop.tailXXXXXX.ts.net:{port}
# Leave unset to use OpenHands only locally at http://localhost:3001.
OPENHANDS_WEB_URL=
OPENHANDS_SANDBOX_URL_PATTERN=

# Generated by scripts/init-env.sh
WEBUI_SECRET_KEY=
